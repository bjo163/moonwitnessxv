# ============================================================================
#  Moonwitness — configuration template
#  cp .env.example .env   (the real .env is gitignored; it is never committed)
#
#  Read by: apps/radio          node --env-file-if-exists=../../.env
#           apps/dock + apps/hq  @moonwitness/web-config (their next.config)
#           docker-compose*.yml  interpolated from this same file
#
#  Every key below is validated by apps/radio/src/config.ts (zod) — an unknown
#  or malformed value fails the boot with one readable list. apps/radio/test/
#  env-contract.test.ts enforces that this file only ever names known keys.
# ============================================================================

# ---- Server (apps/radio) ----
HOST=0.0.0.0
PORT=3000
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Only set true when a real proxy terminates in front of the hub; otherwise a
# client can spoof its own ip/host through X-Forwarded-*.
TRUST_PROXY=false

# ---- API / OpenAPI ----
API_PREFIX=/api/v1
API_TITLE=Moonwitness Hub API
API_VERSION=1.0.0
# RADIO_PORT / RADIO_PREFIX / RADIO_TITLE override the shared defaults if set.

# ---- CORS (comma separated origins) ----
# Both frontends call the hub server-side, so this only matters for browser
# callers (Studio). '*' reflects every origin: keep it for experiments only.
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# ---- Rate limit (unauthenticated entry points: /auth/login, /listen) ----
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ---- Database (apps/radio + compose) ----
# `pnpm db:up` starts Docker Postgres on 127.0.0.1:5432; the host apps reach it
# as localhost, the compose hub reaches it as `db` (see docker-compose.yml).
# Leave DATABASE_URL empty for the zero-config in-memory engine (nothing
# persists across restarts).
POSTGRES_USER=moonwitness
POSTGRES_PASSWORD=change-me
POSTGRES_DB=moonwitness
DATABASE_URL=postgresql://moonwitness:change-me@localhost:5432/moonwitness

# ---- moonql ORM ----
# Additive schema sync at boot (pg only): adds tables/columns/indexes, never drops.
MOONQL_AUTOSYNC=true
# Arm addon-declared crons (auth session purge, ops retention, schedule reindex).
MOONQL_CRON_ENABLED=true
# Seed policy: warn | require (fail boot) | off — no unexpectedly empty tables.
MOONQL_SEED_POLICY=warn
# A REST model without a write rule is anonymous-writable:
# warn lists them at boot, require refuses to boot (what compose uses), off disables.
MOONQL_ACL_POLICY=require

# ---- moonql-auth ----
# Admin seeded ONCE when the users table is empty. In production this variable is
# mandatory: no password is generated or logged there.
MOONQL_AUTH_ADMIN_PASSWORD=change-me

# ---- WhatsApp plugin (Baileys multi-device) ----
# Pairing is admin-only: POST /api/v1/channels/whatsapp/start with a bearer
# token, then GET the same path and scan `detail.qr` (Studio -> Channels does
# both for you). The session directory must be persistent, or you pair again
# every boot.
WHATSAPP_ENABLED=false
WHATSAPP_AUTO_CONNECT=false
WHATSAPP_AUTH_DIR=./data/whatsapp-auth
WHATSAPP_BOT_ENABLED=true
WHATSAPP_BOT_GREETING=Moonwitness WhatsApp bot is online. Send "ping".

# ---- DENPA 電波 (inbound webhook receiver) ----
# Opt-in AND token-gated: enabling it with an empty DENPA_TOKEN is refused (it
# used to mount an open public writer). Send the header x-denpa-key.
DENPA_ENABLED=false
DENPA_TOKEN=

# ---- Frontends (apps/dock, apps/headquarters) ----
# Server-side only: both Next apps are BFFs that call the hub themselves.
RADIO_API_URL=http://127.0.0.1:3000/api/v1
SITE_NAME=Moonwitness
# Advertised by the hub's service index (GET /).
DOCK_URL=http://localhost:3001
HQ_URL=http://localhost:3002
# Session cookie: production is Secure by default; only an explicit false
# (plain-HTTP compose) downgrades it.
HQ_COOKIE_SECURE=false

# Who may frame the dock's /embed/<station> pages (comma-separated origins).
# Empty means nobody: /embed/* keeps frame-ancestors 'none' until you list a site
# here, and '*' is ignored on purpose — opening every origin would frame the whole
# catalog. Read by apps/dock/src/middleware.ts, which sets the CSP per path.
EMBED_ORIGINS=

# ---- compose backup sidecar (docker compose up adds the `backup` service) ----
# Seconds between pg_dump -Fc runs, and how many dumps the volume keeps.
# BACKUP_INTERVAL_SECONDS=3600
# BACKUP_KEEP=48

# ---- Outbound fetches (station liveness probe, "now playing" metadata) -----
# Off by default: it lets the hub call URLs that live in the database. Both
# crons refuse to run until this is true (see packages/core/src/web-fetch.ts for
# the SSRF rules that still apply: no private/loopback targets, no redirects,
# every resolved address checked, the hub's own port refused).
EGRESS_ENABLED=false
# Extra hostnames the egress gate must refuse, on top of db, radio, dock,
# headquarters, localhost and metadata.google.internal. Comma separated.
EGRESS_DENY_HOSTS=

# ---- moonql-ops / playlog retention (days, applied by daily crons) ----
OPS_AUDIT_RETENTION_DAYS=14
OPS_JOB_RETENTION_DAYS=7
# Listen events hold visitor-derived (pseudonymised) data: keep them shorter.
PLAYLOG_RETENTION_DAYS=90
# Listener tokens are a salted hash of whatever the player sends as `listener`.
# Empty keeps today's tokens stable; setting a value re-identifies every listener
# at once (useful after a leak, costly: past play history stops matching).
PLAYLOG_PSEUDONYM_SALT=
