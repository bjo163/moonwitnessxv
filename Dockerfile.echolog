# syntax=docker/dockerfile:1
# Dedicated runtime for ECHOLOG (D19 Object Storage & Attachments).
# The default Dockerfile remains the ARSY Hub; Dockerfile.web stays the Next apps.

# ---- Base ----
FROM node:24-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /repo

# ---- Install deps (derived from the context, never a hand list) ----
FROM base AS deps
COPY scripts/setup-git-hooks.mjs ./scripts/
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=bind,source=.,target=/ctx,readonly \
    cd /ctx \
    && find apps packages tools -mindepth 2 -maxdepth 2 -name package.json | while read -r m; do \
         mkdir -p "/repo/$(dirname "$m")" && cp "/ctx/$m" "/repo/$m"; \
       done
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---- Build ----
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/echolog ./apps/echolog
# The operator console is a separate Vite build (`build:client`) and no server
# route serves it, so the image ships the Fastify service only.
RUN pnpm build:libs && pnpm --filter @moonwitness/echolog build

# ---- Production deps only ----
FROM base AS prod-deps
COPY scripts/setup-git-hooks.mjs ./scripts/
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=bind,source=.,target=/ctx,readonly \
    cd /ctx \
    && find apps packages tools -mindepth 2 -maxdepth 2 -name package.json | while read -r m; do \
         mkdir -p "/repo/$(dirname "$m")" && cp "/ctx/$m" "/repo/$m"; \
       done
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ---- Runtime ----
FROM node:24-slim AS runtime
ENV NODE_ENV=production
WORKDIR /repo
COPY --from=prod-deps /repo ./
COPY --from=build /repo/packages/core/dist packages/core/dist
COPY --from=build /repo/packages/echolog-core/dist packages/echolog-core/dist
COPY --from=build /repo/packages/moonui/dist packages/moonui/dist
COPY --from=build /repo/apps/echolog/package.json apps/echolog/package.json
COPY --from=build /repo/apps/echolog/dist apps/echolog/dist
# Objects and their sidecars live on a volume: ECHOLOG_STORAGE_ROOT is resolved
# against the process cwd, so the compose service points it at /data/echolog.
ENV ECHOLOG_STORAGE_ROOT=/data/echolog
EXPOSE 3006
CMD ["node", "apps/echolog/dist/index.js"]
