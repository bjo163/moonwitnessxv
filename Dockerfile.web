# syntax=docker/dockerfile:1
#
# One image definition for both Next apps:
#   docker build -f Dockerfile.web --build-arg APP=dock -t moonwitness-dock .
#   docker build -f Dockerfile.web --build-arg APP=headquarters -t moonwitness-headquarters .
#
# No `output: 'standalone'` on purpose: tracing a pnpm workspace is fragile,
# a plain `--prod` install + `next start` is predictable.

ARG APP=headquarters

# ---- Base ----
FROM node:24-slim AS base
# two instructions: PATH cannot reference PNPM_HOME while it is being defined
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
# corepack downloads pnpm@<packageManager> on first use: a prompt it is not
# allowed to show would look exactly like a stalled build
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /repo

# ---- Install deps (all workspace manifests are required by the lockfile) ----
# The member manifests are DERIVED from the context: `--frozen-lockfile` needs one
# per lockfile importer, and a hand-kept list drifts every time a package joins.
FROM base AS deps
ARG APP
# root `prepare` lifecycle runs scripts/setup-git-hooks.mjs on every install; the
# deps stages only ship manifests, so the script must exist or install dies on
# MODULE_NOT_FOUND. Outside a Git work tree it exits 0 by design.
COPY scripts/setup-git-hooks.mjs ./scripts/
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=bind,source=.,target=/ctx,readonly \
    cd /ctx \
    && find apps packages -mindepth 2 -maxdepth 2 -name package.json | while read -r m; do \
         mkdir -p "/repo/$(dirname "$m")" && cp "/ctx/$m" "/repo/$m"; \
       done
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ---- Build the libraries, then the selected app ----
# Root `pnpm build` would also build @moonwitness/arsy, whose sources are not
# copied into this stage (only apps/${APP}) — the filter would match nothing and
# the image build would fail. Build the libs, then exactly one frontend.
FROM deps AS build
ARG APP
COPY tsconfig.base.json ./
# `packages` carries @moonwitness/web-config, which the app configs import by name.
# The repo-root scripts/ directory is deliberately NOT copied: it is dev tooling, and
# the shared config pieces it used to hold now live in a real package.
COPY packages ./packages
COPY apps/${APP} ./apps/${APP}
# Not every Next app ships a public/ directory (ORBIT has none), and the runtime
# stage copies it unconditionally because `next start` serves it off disk. Creating
# it here keeps ONE web image definition for every frontend instead of a per-app
# COPY fork.
RUN mkdir -p /repo/apps/${APP}/public
RUN pnpm build:libs && pnpm --filter @moonwitness/${APP} build

# ---- Production deps only ----
# same derivation rule as `deps`: --prod still has to see every importer
FROM base AS prod-deps
COPY scripts/setup-git-hooks.mjs ./scripts/
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN --mount=type=bind,source=.,target=/ctx,readonly \
    cd /ctx \
    && find apps packages -mindepth 2 -maxdepth 2 -name package.json | while read -r m; do \
         mkdir -p "/repo/$(dirname "$m")" && cp "/ctx/$m" "/repo/$m"; \
       done
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod

# ---- Runtime ----
FROM node:24-slim AS runtime
ARG APP
ARG APP_PORT=3002
ENV NODE_ENV=production
# an ARG is not visible to the container shell: without this the CMD's
# `-p ${APP_PORT}` expanded to nothing and `next start` refused to boot
ENV APP_PORT=${APP_PORT}
WORKDIR /repo
COPY --from=prod-deps /repo ./
# the libraries the app imports at runtime (their dist is ESM). web-config is one of
# them: `next start` re-reads next.config.mjs, which imports it, so it must be present
# as a real package — not as repo files copied in beside the image.
COPY --from=build /repo/packages/core/dist packages/core/dist
COPY --from=build /repo/packages/web-config/dist packages/web-config/dist
COPY --from=build /repo/packages/moonql-client/dist packages/moonql-client/dist
COPY --from=build /repo/packages/moonui/dist packages/moonui/dist
COPY --from=build /repo/packages/moonui/moon.css packages/moonui/moon.css
# the app itself: manifest, config, build output
COPY --from=build /repo/apps/${APP}/package.json apps/${APP}/package.json
COPY --from=build /repo/apps/${APP}/next.config.mjs apps/${APP}/next.config.mjs
COPY --from=build /repo/apps/${APP}/.next apps/${APP}/.next
# `next start` serves public/ straight off disk — it is not bundled into .next.
# Without this every artwork file and the PWA icon 404 in the deployed app.
COPY --from=build /repo/apps/${APP}/public apps/${APP}/public
EXPOSE ${APP_PORT}
WORKDIR /repo/apps/${APP}
CMD ["sh", "-c", "exec ./node_modules/.bin/next start -p ${APP_PORT}"]
