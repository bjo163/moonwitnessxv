{
  // Proyek khusus berkas tes.
  //
  // `apps/arsy/tsconfig.json` ber-`rootDir: ./src` karena itulah yang dipancarkan
  // ke `dist/` dan dijalankan di produksi; tes tidak boleh ikut terkirim ke image.
  // Tapi tes juga tidak boleh tanpa-check: ia memakai API yang sama dengan hub, dan
  // tanpa proyek sendiri ia tidak terlihat oleh TypeScript maupun ESLint type-checked.
  // Karena itu: noEmit di sini, dan `pnpm --filter @moonwitness/arsy typecheck`
  // memanggil kedua proyek.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // Sengaja tanpa `rootDir`: proyek ini tidak memancarkan apa pun (noEmit), jadi
    // rootDir hanya akan memicu TS6059 untuk sumber yang sah di luar apps/arsy —
    // `test/aigateway.test.ts` mengimpor ../../aigateway/src karena paket
    // `@moonwitness/aigateway` tidak mengekspos buildServer/provider lewat exports map.
    "lib": ["ES2022"]
  },
  // `src/fastify.d.ts` ikut di-include: di situlah `app.moonql`/`app.channels`
  // didaftarkan ke FastifyInstance. Tanpa berkas itu, setiap tes yang membaca
  // dekorasi tersebut gagal typecheck meski runtime-nya benar.
  "include": ["./**/*.ts", "../src/fastify.d.ts"],
  "references": [{ "path": "../tsconfig.json" }]
}
