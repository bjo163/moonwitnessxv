{
  "name": "@moonwitness/echolog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "build:client": "vite build",
    "dev": "node --import tsx --env-file-if-exists=../../.env src/index.ts",
    "dev:client": "vite",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@moonwitness/echolog-core": "workspace:*",
    "@moonwitness/moonui": "workspace:*",
    "@smithy/signature-v4": "5.7.4",
    "@smithy/types": "4.19.0",
    "fastify": "^5.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@moonwitness/moonql": "workspace:*",
    "@moonwitness/moonql-auth": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5"
  }
}
