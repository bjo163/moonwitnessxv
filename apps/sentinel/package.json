{
  "name": "@moonwitness/sentinel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=../../.env src/index.ts",
    "once": "node --import tsx --env-file-if-exists=../../.env src/index.ts --once",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "tsx --test test/worker-log-contract.test.ts test/observation-contract.test.ts"
  },
  "dependencies": {
    "@moonwitness/core": "workspace:*",
    "@moonwitness/moonql-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
