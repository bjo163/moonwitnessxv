{
  // Proyek khusus berkas tes apps/sentinel (pola yang sama dengan
  // apps/aigateway/test/tsconfig.json dan apps/arsy/test/tsconfig.json):
  // noEmit, terlihat oleh typecheck terpisah dan oleh ESLint projectService,
  // tanpa ikut ter-emit ke dist/ produksi.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["./**/*.ts"],
  "references": [{ "path": "../tsconfig.json" }]
}
